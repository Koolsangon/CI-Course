{
  "id": "04-material-yield",
  "title": "재료비 절감 & 수율 하락",
  "scenario": "원재료 업체를 변경하여 Module 재료비를 5% 절감했으나, Module 수율 또한 4% 감소 하였습니다.",
  "adapter": "material-yield",
  "reference": {
    "price": 200,
    "yields": { "tft": 0.99, "cf": 1.0, "cell": 0.95, "module": 0.972 },
    "bom": { "tft": 6.0, "cf": 5.0, "cell": 1.5, "module": 75.0 },
    "processing": {
      "panel": { "labor": 21.3, "expense": 11.5, "depreciation": 16.2 },
      "module": { "labor": 8.7, "expense": 5.3, "depreciation": 7.5 }
    },
    "sga": { "direct_dev": 4.7, "transport": 0.3, "business_unit": 16.0, "operation": 1.2, "corporate_oh": 6.2 },
    "loading": 0.70
  },
  "variables": [
    {
      "key": "material_change_pct",
      "ko": "Module 재료비 변동률",
      "min": -0.20,
      "max": 0.20,
      "step": 0.005,
      "default": -0.05,
      "unit": "%",
      "format": "percent_delta",
      "description": "Module BOM 변경 → Module 소요재료비 → 소요재료비 합계 → COM → COP → 영업이익"
    },
    {
      "key": "module_yield_change",
      "ko": "Module 수율 변동률",
      "min": -0.10,
      "max": 0.05,
      "step": 0.005,
      "default": -0.04,
      "unit": "%p",
      "format": "percent_point",
      "description": "Module 수율 변경 → 누적수율 → 소요재료비(BOM÷수율) → 가공비 6항목 → COM → COP → 영업이익"
    }
  ],
  "expected": {
    "bom_module": 71.25,
    "module_yield": 0.932,
    "material_cost": 90.6
  },
  "inspector": {
    "delta_groups": [
      {
        "title": "1. Module 재료비 변동",
        "lines": [
          { "label": "Module Net 재료비", "expr_template": "75.0 × {slider:material_change_pct_inv}" },
          { "label": "소요재료비 TFT",    "expr_template": "6.0 ÷ 91.4%" },
          { "label": "소요재료비 CF",     "expr_template": "5.0 ÷ 100.0% ÷ 95.0% ÷ 97.2%" },
          { "label": "소요재료비 Cell",   "expr_template": "1.5 ÷ 95.0% ÷ 97.2%" },
          { "label": "소요재료비 Module", "expr_template": "{module_net} ÷ 97.2%" }
        ]
      },
      {
        "title": "2. Module 수율 변동",
        "lines": [
          { "label": "Module 수율",       "expr_template": "97.2% − {slider:module_yield_drop_abs}" },
          { "label": "소요재료비 TFT",    "expr_template": "6.0 ÷ {cum_yield_new}" },
          { "label": "소요재료비 CF",     "expr_template": "5.0 ÷ 100.0% ÷ 95.0% ÷ {module_yield_new}" },
          { "label": "소요재료비 Cell",   "expr_template": "1.5 ÷ 95.0% ÷ {module_yield_new}" },
          { "label": "소요재료비 Module", "expr_template": "{module_net} ÷ {module_yield_new}" },
          { "label": "Panel 노무비",      "expr_template": "21.3 × 97.2% ÷ {module_yield_new}" },
          { "label": "Panel 경비",        "expr_template": "11.5 × 97.2% ÷ {module_yield_new}" },
          { "label": "Panel 감상비",      "expr_template": "16.2 × 97.2% ÷ {module_yield_new}" },
          { "label": "Module 노무비",     "expr_template": "8.7 × 97.2% ÷ {module_yield_new}" },
          { "label": "Module 경비",       "expr_template": "5.3 × 97.2% ÷ {module_yield_new}" },
          { "label": "Module 감상비",     "expr_template": "7.5 × 97.2% ÷ {module_yield_new}" }
        ]
      }
    ],
    "result_fields": ["processing_cost", "com", "cop", "operating_profit"]
  },
  "tree_info": [
    { "label": "Module 수율",       "field": "module_yield_pct", "format": "percent1" },
    { "label": "Net 재료비(Module)", "field": "module_net_bom",   "format": "dollar1" }
  ],
  "phases": {
    "hook": "재료비 5% 절감. 좋은 거래처럼 보이지만, 수율이 떨어진다면?",
    "discover": "두 슬라이더를 동시에 움직여 소요재료비가 어떻게 변하는지 확인해보세요.",
    "apply": {
      "question": "재료비 -5% + 수율 -4%p일 때, 새 소요재료비는 약 얼마인가요?",
      "answer_key": 90.6,
      "tolerance": 0.3,
      "hint": "소요재료비 = Σ(BOM/누적수율). 수율이 줄면 분모가 줄어 결과는 커집니다.",
      "hints": {
        "l1": "이 문제는 두 변화(BOM 절감, 수율 하락)가 같은 셀에 동시에 작용합니다. 두 변화가 결과를 같은 방향으로 미는지, 반대 방향으로 미는지 먼저 머릿속으로 그려 보세요.",
        "l2": "소요재료비는 단계별 BOM을 누적수율로 나눠 더한 값입니다. BOM 절감은 분자를 작게 만들지만, Module 수율 하락은 누적수율(TFT × CF × Cell × Module)을 작게 만들어 결과를 키웁니다. 즉 두 효과는 서로 상쇄되는 방향이에요.",
        "l3": "공식은 다음과 같습니다 — 새 소요재료비 = Σ(BOM_새 / 누적수율_새). Module BOM은 5% 줄여 적용하고, 누적수율은 Module 수율을 −4%p 한 뒤 다시 곱해 구한 값을 분모로 씁니다. Reference의 BOM·수율 값을 직접 넣어 계산해 보세요. (정답 숫자는 직접 계산해 주세요.)"
      }
    },
    "reflect": "절감 효과가 거의 사라진 이유를 한 문장으로 설명하세요."
  },
  "coach": {
    "hook": "절감과 손실이 상쇄되는 트레이드오프, 어느 쪽이 이길까요?",
    "discover": "두 효과가 서로 반대 방향이라는 점을 트리에서 확인해보세요.",
    "apply": "BOM을 먼저 적용한 뒤 수율 변화를 적용해보세요. 순서는 결과에 영향을 주지 않습니다.",
    "reflect": "한 문장: '절감은 분자를 ___하고, 수율 하락은 분모를 ___한다.'"
  }
}
